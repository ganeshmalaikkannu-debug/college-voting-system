{
  "info": {
    "_postman_id": "c7a8b9d0-1234-4567-89ab-cdef01234567",
    "name": "College Voting System API",
    "description": "Complete REST API collection for Apex Institute College Voting System. Includes authentication, election management, candidate nominations, anonymous voting, participation turnout audit, and results publication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "voterToken", "value": "", "type": "string" },
    { "key": "electionId", "value": "1", "type": "string" },
    { "key": "candidateId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register New Voter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kavita Sharma\",\n  \"rollNumber\": \"24CS999\",\n  \"email\": \"kavita.s@apex.edu\",\n  \"department\": \"Computer Science\",\n  \"password\": \"KavitaPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    console.log('Saved adminToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"ADM001\",\n  \"password\": \"AdminSecure@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Demo Voter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('voterToken', jsonData.token);",
                  "    console.log('Saved voterToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"24CS002\",\n  \"password\": \"VoterSecure@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Elections Management",
      "item": [
        {
          "name": "List All Elections",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/elections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections"]
            }
          }
        },
        {
          "name": "Create Election (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('electionId', jsonData.id.toString());",
                  "    console.log('Saved electionId: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Department Representative 2026\",\n  \"description\": \"Election for Computer Science Department Student Representative\",\n  \"startTime\": \"2026-10-20T09:00:00\",\n  \"endTime\": \"2026-10-20T18:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections"]
            }
          }
        },
        {
          "name": "Get Election by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}"]
            }
          }
        },
        {
          "name": "Update Election (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Department Representative 2026 (Updated)\",\n  \"description\": \"Election for CS Department Representative\",\n  \"startTime\": \"2026-10-20T08:00:00\",\n  \"endTime\": \"2026-10-20T20:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}"]
            }
          }
        },
        {
          "name": "Update Status to UPCOMING",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"UPCOMING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "status"]
            }
          }
        },
        {
          "name": "Update Status to ACTIVE",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "status"]
            }
          }
        },
        {
          "name": "Update Status to CLOSED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "status"]
            }
          }
        },
        {
          "name": "Toggle Results Visibility (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resultsPublished\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/results-visibility",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "results-visibility"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Candidates Management",
      "item": [
        {
          "name": "List Candidates for Election",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "candidates"]
            }
          }
        },
        {
          "name": "Nominate Candidate (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('candidateId', jsonData.id.toString());",
                  "    console.log('Saved candidateId: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aditya Narayan\",\n  \"rollNumber\": \"24CS301\",\n  \"manifesto\": \"Advocate for open coding labs and 24/7 technical library access.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "candidates"]
            }
          }
        },
        {
          "name": "Update Candidate (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aditya Narayan\",\n  \"rollNumber\": \"24CS301\",\n  \"manifesto\": \"Updated manifesto: 24/7 open coding labs, hackathons, and mentorship.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "{{candidateId}}"]
            }
          }
        },
        {
          "name": "Delete Candidate (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Voting, Audit & Results",
      "item": [
        {
          "name": "Cast Vote (Voter Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": {{candidateId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/votes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "votes"]
            }
          }
        },
        {
          "name": "Attempt Double Vote (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": {{candidateId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/votes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "votes"]
            }
          }
        },
        {
          "name": "Get Turnout Participation (Admin Only - Anonymous Ballot)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/participation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "participation"]
            }
          }
        },
        {
          "name": "Get Election Results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{voterToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/elections/{{electionId}}/results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "elections", "{{electionId}}", "results"]
            }
          }
        }
      ]
    }
  ]
}
